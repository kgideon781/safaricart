# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://safaricart:safaricart@localhost:5432/safaricart?schema=public"
# Direct (non-pooled) connection used by `prisma migrate deploy` and Studio.
# In local dev, set this to the same value as DATABASE_URL.
# In production with Neon/Supabase, use the connection string WITHOUT `-pooler`.
DIRECT_URL="postgresql://safaricart:safaricart@localhost:5432/safaricart?schema=public"

# Public origin used for outbound links (emails, sitemap, payment callback URLs).
# In dev this is your tunnel URL (e.g. ngrok) when testing M-Pesa callbacks.
APP_URL="http://localhost:3000"

# Auth.js v5 (NextAuth)
# Generate AUTH_SECRET with:  openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth — https://developers.facebook.com/apps
# Authorized redirect URI: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Payments ---

# M-Pesa Daraja API (https://developer.safaricom.co.ke)
# Sandbox defaults are baked in if SHORTCODE/PASSKEY are blank — for testing only.
MPESA_ENV="sandbox"             # sandbox | production
MPESA_CONSUMER_KEY=""            # Daraja app consumer key
MPESA_CONSUMER_SECRET=""         # Daraja app consumer secret
MPESA_SHORTCODE=""               # Paybill / Till. Sandbox default: 174379
MPESA_PASSKEY=""                 # LNM passkey. Sandbox default baked in.
MPESA_CALLBACK_URL=""            # Public HTTPS URL, e.g. https://yourdomain.com/api/webhooks/mpesa

# Paystack (https://dashboard.paystack.com/#/settings/developer) — optional
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email (nodemailer SMTP) ---
# Brevo (preferred): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false.
# For local dev, https://ethereal.email or Mailtrap also work.
# Gmail requires an App Password (not your account password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"              # true if SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# Default FROM — used when a purpose-specific FROM below isn't set.
EMAIL_FROM="SafariCart <no-reply@safaricart.co.ke>"
# Per-purpose FROM addresses. Leave any blank to fall back to EMAIL_FROM.
# Each address must be verified on your SMTP provider (Brevo: Senders & domains).
EMAIL_FROM_SYSTEM="SafariCart <no-reply@safaricart.co.ke>"   # password reset, verification
EMAIL_FROM_ORDERS="SafariCart Orders <orders@safaricart.co.ke>"
EMAIL_FROM_SUPPORT="SafariCart Support <support@safaricart.co.ke>"
EMAIL_FROM_SALES="SafariCart <sales@safaricart.co.ke>"

# --- Cloudinary (image uploads) ---
# https://cloudinary.com/console — free tier
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="safaricart"

# --- Settings encryption key (REQUIRED if you use /admin/integrations) ---
# Encrypts payment/email/upload secrets stored in the DB.
# Generate with:  openssl rand -base64 32
# Treat like a database password — do NOT rotate without re-encrypting rows.
SETTINGS_ENCRYPTION_KEY=""

# --- Bootstrap admins ---
# Comma-separated emails auto-promoted to ADMIN on sign-in. Idempotent (no-op
# if already ADMIN). Remove an email to stop re-promotion; existing admins are
# never demoted by this. Useful for fresh deploys so you don't have to SQL-hack
# the first admin in.
INITIAL_ADMIN_EMAILS=""
