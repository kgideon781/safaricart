// SafariCart database schema
//
// Conventions
//   • Money is stored as integer KES (no subdivision). Field names ending in
//     `Kes` make the unit explicit. KES is a zero-decimal currency in both
//     Stripe and M-Pesa, so no conversion is needed.
//   • Phone numbers are E.164 strings (+254XXXXXXXXX). Normalize at app layer
//     with `normalizeKenyanPhone()` before persisting.
//   • `county` is a String, validated against `KENYAN_COUNTIES` (lib/kenya.ts)
//     at the app layer rather than as a Postgres enum — easier to evolve.
//   • IDs are CUIDs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a non-pooled connection (PgBouncer breaks prepared statements).
  // Falls back to DATABASE_URL when DIRECT_URL is unset (local dev).
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────
// Authentication (Auth.js v5 / @auth/prisma-adapter)
// ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  phone         String?   @unique // E.164; nullable so users can register email-only
  passwordHash  String? // null for OAuth-only accounts
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  vendor            Vendor?
  addresses         Address[]
  orders            Order[]
  cart              Cart?
  reviews           Review[]
  couponRedemptions CouponRedemption[]
  quoteRequests     QuoteRequest[]
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

// Field names below are snake_case to match the Auth.js Prisma adapter spec.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Used by Auth.js for email magic links AND by us for email verification +
// password reset. `identifier` is the email; `token` is a 32-byte random
// hex string. We store the SHA-256 hash, never the raw token.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  // Discriminator so a single table covers both flows. `purpose` is null for
  // Auth.js email-magic-link tokens (which we don't use today) and explicit
  // for our flows: "EMAIL_VERIFICATION" | "PASSWORD_RESET".
  purpose    String?

  @@unique([identifier, token])
}

// Runtime-configurable integrations (M-Pesa, Stripe, Paystack, SMTP,
// Cloudinary, ...). Lets an admin paste credentials and flip a switch
// without redeploying. Resolution order at runtime is DB-first; env vars
// remain as fallbacks for bootstrap.
//
//   • `publicConfig` holds non-secret values (shortcodes, hostnames, sender
//     emails, public keys, etc.) as a JSON object.
//   • `secretsCipher` holds an AES-256-GCM ciphertext blob — a single JSON
//     object encrypted with SETTINGS_ENCRYPTION_KEY. Never stored in plain
//     text. Format: base64(iv) + ":" + base64(ciphertext) + ":" + base64(tag).
//   • `enabled` decides whether the resolver uses DB values or falls back
//     to env. Toggle at /admin/integrations.
//   • `testMode` is a hint to the integration (e.g. M-Pesa sandbox/prod).
model Integration {
  scope         String   @id // "mpesa" | "stripe" | "paystack" | "smtp" | "cloudinary"
  enabled       Boolean  @default(false)
  testMode      Boolean  @default(true)
  publicConfig  Json     @default("{}")
  secretsCipher String?
  updatedAt     DateTime @updatedAt
  updatedBy     String?
  createdAt     DateTime @default(now())
}

// Generic IP/email-based rate limiter. One row per (key, window) bucket.
model RateLimit {
  id        String   @id @default(cuid())
  key       String // e.g. "login:ip:1.2.3.4" or "register:email:foo@bar"
  windowAt  DateTime // start of the current window (truncated)
  hits      Int      @default(1)
  expiresAt DateTime // for cleanup
  createdAt DateTime @default(now())

  @@unique([key, windowAt])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────
// Vendors
// ────────────────────────────────────────────────────────────

model Vendor {
  id          String       @id @default(cuid())
  userId      String       @unique
  slug        String       @unique
  name        String
  description String?
  logoUrl     String?
  coverUrl    String?
  status      VendorStatus @default(PENDING)
  verifiedAt  DateTime?

  contactEmail String
  contactPhone String // E.164
  county       String // one of KENYAN_COUNTIES

  // Payout — one of these is populated (preferences vary by vendor)
  mpesaPaybill      String?
  mpesaTillNumber   String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?

  // KRA tax PIN (Kenya), used on payouts
  kraPin String?

  // Platform commission in basis points (10000 = 100%, 1000 = 10%).
  // Stored per-vendor to allow case-by-case negotiation.
  commissionBps Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products      Product[]
  orderItems    OrderItem[]
  documents     VendorDocument[]
  ledgerEntries VendorLedgerEntry[]
  payouts       VendorPayout[]
  coupons       Coupon[]

  @@index([status])
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

// KYC: each vendor uploads identity / business / tax documents for review.
model VendorDocument {
  id           String               @id @default(cuid())
  vendorId     String
  type         VendorDocumentType
  fileUrl      String // Cloudinary secure URL
  filePublicId String? // Cloudinary public ID for deletion
  status       VendorDocumentStatus @default(PENDING)
  notes        String? // admin reviewer notes
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

enum VendorDocumentType {
  NATIONAL_ID
  BUSINESS_CERTIFICATE
  KRA_PIN_CERTIFICATE
  BANK_STATEMENT
  OTHER
}

enum VendorDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ────────────────────────────────────────────────────────────
// Catalog
// ────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isFeatured])
}

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  description       String
  vendorId          String
  categoryId        String
  priceKes          Int
  compareAtPriceKes Int? // for "was X, now Y" sale UI
  sku               String?
  stock             Int      @default(0)
  weightGrams       Int? // for shipping calc
  images            String[] // URLs; first is primary
  isPublished       Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    Review[]

  @@unique([vendorId, sku])
  @@index([vendorId, isPublished])
  @@index([categoryId, isPublished])
  @@index([isFeatured, isPublished])
}

// ────────────────────────────────────────────────────────────
// Addresses
// ────────────────────────────────────────────────────────────

model Address {
  id             String   @id @default(cuid())
  userId         String
  label          String? // "Home", "Work"
  recipientName  String
  recipientPhone String // E.164
  county         String
  subCounty      String?
  ward           String?
  streetAddress  String
  landmark       String? // common in Kenyan addresses ("near KFC junction")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────────────────────
// Cart (persistent, logged-in users only; guests use session storage)
// ────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

// ────────────────────────────────────────────────────────────
// Coupons
// ────────────────────────────────────────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique // uppercase, e.g. "JAMHURI10"
  type           CouponType
  // For PERCENT: 1000 = 10.00% (basis points). For FIXED: KES integer.
  value          Int
  minSubtotalKes Int        @default(0)
  // Optional cap on percent discounts
  maxDiscountKes Int?
  // Optional vendor scope — if set, only applies to that vendor's items.
  vendorId       String?
  // Total uses across all customers; null = unlimited
  maxUses        Int?
  // Per-customer usage cap; null = unlimited
  perUserLimit   Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  vendor      Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]
  orders      Order[]
  campaigns   Campaign[]

  @@index([isActive, expiresAt])
}

enum CouponType {
  PERCENT
  FIXED
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  orderId    String   @unique
  amountKes  Int
  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────
// Orders
// Address and product details are SNAPSHOTTED at order time so historical
// orders remain accurate even if the product or address is later edited.
// ────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // human-readable, e.g. SC-202605-00001
  userId      String
  status      OrderStatus @default(PENDING)

  // Money (KES)
  subtotalKes    Int
  shippingFeeKes Int @default(0)
  discountKes    Int @default(0)
  totalKes       Int

  // Coupon (snapshot)
  couponId   String?
  couponCode String?

  // Shipping address snapshot
  shippingRecipientName  String
  shippingRecipientPhone String
  shippingCounty         String
  shippingSubCounty      String?
  shippingStreetAddress  String
  shippingLandmark       String?

  // Payment
  paymentMethod    PaymentMethod
  paymentReference String? // gateway-specific transaction ID (Stripe session id, M-Pesa CheckoutRequestID, etc.)
  paidAt           DateTime?

  // Cancellation / refund
  cancelledAt  DateTime?
  cancelReason String?
  refundedAt   DateTime?
  refundedKes  Int?
  refundReason String?

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  items             OrderItem[]
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption  CouponRedemption?
  mpesaTransactions MpesaTransaction[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([paymentReference])
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  PAYSTACK
  STRIPE
  CASH_ON_DELIVERY
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  vendorId  String // denormalized for fast vendor-side queries

  // Snapshot fields (preserve history if product is edited or deleted)
  productTitle String
  productImage String?
  unitPriceKes Int
  quantity     Int
  subtotalKes  Int

  // Per-item fulfillment — one order can have items from multiple vendors,
  // each shipping on its own timeline.
  fulfillmentStatus OrderItemFulfillmentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  ledgerEntries VendorLedgerEntry[]

  @@index([orderId])
  @@index([vendorId, fulfillmentStatus])
  @@index([productId])
}

enum OrderItemFulfillmentStatus {
  PENDING
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
}

// One row per Daraja STK push attempt + each callback we receive.
// Callbacks are idempotent on (checkoutRequestId, resultCode).
model MpesaTransaction {
  id                 String                 @id @default(cuid())
  orderId            String
  merchantRequestId  String?
  checkoutRequestId  String                 @unique
  amountKes          Int
  phoneE164          String
  status             MpesaTransactionStatus @default(PENDING)
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?
  transactionDate    DateTime?
  rawCallback        Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

enum MpesaTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

// ────────────────────────────────────────────────────────────
// Reviews
// ────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int // 1–5; validate at app layer with Zod
  title      String?
  body       String
  // Moderation
  isFlagged  Boolean  @default(false)
  isHidden   Boolean  @default(false)
  flagReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // one review per user per product
  @@index([productId])
  @@index([userId])
  @@index([isFlagged, isHidden])
}

// ────────────────────────────────────────────────────────────
// Vendor payout ledger
// ────────────────────────────────────────────────────────────
//
// One credit entry is created per OrderItem when its fulfillment reaches
// DELIVERED (vendor has earned). Refunds create a debit (negative) entry.
// Payouts group entries together — when the admin disburses, we mark them
// settled and link to a VendorPayout row.

model VendorLedgerEntry {
  id          String          @id @default(cuid())
  vendorId    String
  // Item that earned this entry; null for manual adjustments.
  orderItemId String?
  type        LedgerEntryType
  // Positive (CREDIT/REFUND_REVERSAL) or negative (REFUND/ADJUSTMENT) integer KES
  amountKes   Int
  description String?
  payoutId    String?
  createdAt   DateTime        @default(now())

  vendor    Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItem OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  payout    VendorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([payoutId])
}

enum LedgerEntryType {
  SALE_CREDIT // vendor share of a delivered item
  COMMISSION_DEBIT // platform commission deducted (recorded separately for clarity)
  REFUND_DEBIT // customer was refunded; vendor portion reversed
  ADJUSTMENT // manual admin adjustment
}

model VendorPayout {
  id               String       @id @default(cuid())
  vendorId         String
  amountKes        Int
  status           PayoutStatus @default(PENDING)
  method           PayoutMethod
  // Snapshot of where money was sent
  destinationLabel String // e.g. "M-Pesa Paybill 522522 — acct 123" or "KCB ****1234"
  notes            String?
  initiatedAt      DateTime     @default(now())
  settledAt        DateTime?
  reference        String? // bank/M-Pesa transaction reference
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vendor  Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  entries VendorLedgerEntry[]

  @@index([vendorId, status])
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum PayoutMethod {
  MPESA
  BANK
}

// ────────────────────────────────────────────────────────────
// Marketing
// ────────────────────────────────────────────────────────────

// Site-wide promotional banner. Active when isActive AND (startsAt..endsAt)
// covers now. The associated coupon (optional) lets a Black Friday campaign
// be one entity from the admin's POV: banner advertises code, code applies
// the discount via the existing CouponRedemption flow.
model Campaign {
  id            String   @id @default(cuid())
  title         String // admin-only label, never shown publicly
  message       String // the banner text shown to all visitors
  ctaLabel      String?
  ctaHref       String?
  couponId      String?
  startsAt      DateTime @default(now())
  endsAt        DateTime
  isActive      Boolean  @default(true)
  isDismissible Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
}

// Newsletter subscribers captured from the footer form. Email is the natural
// key; resubscribe is a no-op (upsert). Unsubscribed rows are kept for audit
// rather than deleted.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  source         String? // optional context: "footer", "checkout", etc.
}

// ────────────────────────────────────────────────────────────
// Quote requests
// Customers ask for items SafariCart doesn't yet stock. An admin reviews,
// sources the item, and replies with a quoted price. Customer then accepts
// or declines. Email transitions: submitted → admin notified; quoted →
// customer notified.
// ────────────────────────────────────────────────────────────

model QuoteRequest {
  id              String             @id @default(cuid())
  userId          String
  title           String
  description     String
  quantity        Int                @default(1)
  // Customer's optional ceiling. Helps admin decide whether to source.
  targetPriceKes  Int?
  // Snapshot — may differ from User.phone (e.g. friend's phone for delivery).
  contactPhone    String // E.164
  preferredCounty String? // optional delivery county
  imageUrls       String[] // optional reference images; up to 4
  status          QuoteRequestStatus @default(PENDING)

  // Admin reply (set when status moves PENDING → QUOTED)
  adminReplyKes      Int?
  adminReplyLeadTime String? // free text: "3-5 business days", etc.
  adminReplyNotes    String?
  adminReplyAt       DateTime?
  adminReplyBy       String? // admin user id; not a FK so we keep the audit row
  // Quote validity — after this we treat it as expired/CLOSED.
  adminReplyExpires  DateTime?

  // Customer decision (set on ACCEPTED / DECLINED)
  customerDecisionAt    DateTime?
  customerDeclineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum QuoteRequestStatus {
  PENDING // awaiting admin response
  QUOTED // admin has provided a price, awaiting customer decision
  ACCEPTED // customer accepted — admin will follow up to place the order
  DECLINED // customer declined the quote
  CLOSED // admin closed (spam, can't source, expired)
}
